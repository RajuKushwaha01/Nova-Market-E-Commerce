<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Invoice - <%= order.orderNumber %></title>
<style>
  body { font-family: Arial, sans-serif; color: #111; padding: 40px; }
  .header { display:flex; justify-content:space-between; border-bottom: 2px solid #7C3AED; padding-bottom: 16px; margin-bottom: 24px; }
  .logo { font-size: 22px; font-weight: bold; color: #7C3AED; }
  table { width: 100%; border-collapse: collapse; margin-top: 16px; }
  th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 14px; }
  th { background: #f3f3f3; }
  .totals { margin-top: 16px; float: right; width: 250px; }
  .totals div { display:flex; justify-content:space-between; padding: 4px 0; font-size: 14px; }
  @media print { .print-btn { display: none; } }
</style>
</head>
<body>
  <button class="print-btn" onclick="window.print()">🖨 Print / Save as PDF</button>

  <div class="header">
    <div>
      <div class="logo">NOVA MARKET</div>
      <p>Tax Invoice</p>
    </div>
    <div style="text-align:right">
      <p>Order #<%= order.orderNumber %></p>
      <p>Date: <%= new Date(order.createdAt).toDateString() %></p>
    </div>
  </div>

  <p><strong>Billed To:</strong><br>
  <%= order.address.fullName %><br>
  <%= order.address.houseNumber %>, <%= order.address.street %><br>
  <%= order.address.city %>, <%= order.address.state %> - <%= order.address.pincode %><br>
  Mobile: <%= order.address.mobile %></p>

  <table>
    <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
    <tbody>
      <% order.items.forEach(item => { %>
        <tr>
          <td><%= item.name %><% if (item.variantLabel) { %> (<%= item.variantLabel %>)<% } %></td>
          <td><%= item.quantity %></td>
          <td>₹<%= item.price %></td>
          <td>₹<%= item.price * item.quantity %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="totals">
    <div><span>Subtotal</span><span>₹<%= order.subtotal %></span></div>
    <div><span>Discount</span><span>- ₹<%= order.productDiscount %></span></div>
    <div><span>Delivery</span><span>₹<%= order.deliveryFee %></span></div>
    <% if (order.codFee) { %><div><span>COD Fee</span><span>₹<%= order.codFee %></span></div><% } %>
    <div style="font-weight:bold; border-top:1px solid #333; margin-top:6px;"><span>Total</span><span>₹<%= order.totalAmount %></span></div>
  </div>

  <div style="clear:both; margin-top:60px; font-size:12px; color:#666;">
    Payment Method: <%= order.paymentMethod %> (<%= order.paymentStatus %>)<br>
    This is a computer-generated invoice.
  </div>
</body>
</html>