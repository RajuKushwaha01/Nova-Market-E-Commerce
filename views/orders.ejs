<%- include('partials/header') %>
<section class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold heading mb-4">My Orders</h1>

  <div class="flex gap-4 overflow-x-auto mb-6 text-sm">
    <% ['All','Processing','Shipped','Delivered','Cancelled','Returned','Refunded'].forEach(tab => { %>
      <a href="/orders?tab=<%= tab %>" class="px-4 py-2 rounded-md whitespace-nowrap <%= activeTab === tab ? 'gradient-btn' : 'border border-border2 text-textSecondary' %>">
        <%= tab %>
      </a>
    <% }) %>
  </div>

  <% if (orders.length === 0) { %>
    <div class="card p-10 text-center text-textSecondary">No orders found.</div>
  <% } %>

  <div class="space-y-4">
    <% orders.forEach(o => { %>
      <a href="/orders/<%= o._id %>" class="card p-4 block">
        <div class="flex justify-between text-sm mb-2">
          <span class="text-textSecondary">#<%= o.orderNumber %> · <%= new Date(o.createdAt).toDateString() %></span>
          <span class="font-semibold">₹<%= o.totalAmount %></span>
        </div>
        <% o.items.forEach(item => { %>
          <p class="text-sm flex justify-between">
            <span><%= item.name %> x <%= item.quantity %></span>
            <span class="badge-discount"><%= item.status.replace(/_/g,' ') %></span>
          </p>
        <% }) %>
      </a>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>