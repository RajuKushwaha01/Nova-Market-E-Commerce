<%- include('partials/header') %>
<section class="max-w-md mx-auto px-4 py-16">
  <div class="card p-8">
    <h1 class="text-xl font-bold heading mb-6 gradient-text">Forgot Password</h1>
    <% if (error) { %><p class="text-error text-sm mb-4"><%= error %></p><% } %>
    <% if (success) { %><p class="text-success text-sm mb-4"><%= success %></p><% } %>
    <form action="/forgot-password" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="email" name="email" placeholder="Registered Email" required
        class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <button class="gradient-btn w-full py-2 rounded-md font-semibold">Send Reset Link</button>
    </form>
    <p class="text-textSecondary text-sm mt-4"><a href="/login" class="text-cyan">Back to Login</a></p>
  </div>
</section>
<%- include('partials/footer') %>