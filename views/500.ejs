<%- include('partials/header') %>
<section class="max-w-2xl mx-auto px-4 py-24 text-center">
  <h1 class="text-4xl font-bold heading text-error mb-4">500</h1>
  <p class="text-textSecondary mb-2">Something went wrong on our end.</p>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="text-textSecondary text-sm mb-6"><%= message %></p>
  <% } %>
  <a href="/" class="gradient-btn px-6 py-3 rounded-md font-semibold">Go Home</a>
</section>
<%- include('partials/footer') %>