<%- include('partials/header') %>
<section class="max-w-2xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold heading">Notifications</h1>
    <form action="/notifications/mark-all-read" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-cyan text-sm">Mark all read</button></form>
  </div>
  <div class="space-y-3">
    <% notifications.forEach(n => { %>
      <div class="card p-4 <%= n.isRead ? 'opacity-60' : '' %>">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-sm font-medium"><%= n.title %></p>
            <p class="text-xs text-textSecondary"><%= n.message %></p>
            <a href="<%= n.link %>" class="text-cyan text-xs">View →</a>
          </div>
          <div class="flex gap-2 text-xs">
            <% if (!n.isRead) { %>
              <form action="/notifications/<%= n._id %>/read" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-cyan">Mark read</button></form>
            <% } %>
            <form action="/notifications/<%= n._id %>/delete" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-error">✕</button></form>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (notifications.length === 0) { %><div class="card p-10 text-center text-textSecondary">No notifications.</div><% } %>
  </div>
</section>
<%- include('partials/footer') %>