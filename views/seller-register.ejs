<%- include('partials/header') %>
<section class="max-w-lg mx-auto px-4 py-16">
  <div class="card p-8">
    <h1 class="text-xl font-bold heading mb-2 gradient-text">Become a NOVA Seller</h1>
    <p class="text-textSecondary text-sm mb-6">Register your business and start selling today.</p>
    <% if (error) { %><p class="text-error text-sm mb-4"><%= error %></p><% } %>
    <form action="/seller/register" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="name" placeholder="Your Full Name" required class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <input type="email" name="email" placeholder="Business Email" required class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <input name="mobile" placeholder="Mobile Number" required class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <input type="password" name="password" placeholder="Password" required minlength="8" class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <hr class="border-border2">
      <input name="businessName" placeholder="Business Name" required class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <input name="gstNumber" placeholder="GST Number" class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <input name="panNumber" placeholder="PAN Number" class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
      <textarea name="businessAddress" placeholder="Business Address" required class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2"></textarea>
      <button class="gradient-btn w-full py-2 rounded-md font-semibold">Submit for Review</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>