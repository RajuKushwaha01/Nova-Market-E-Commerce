<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6 max-w-4xl">
    <h1 class="text-2xl font-bold heading mb-4">Categories</h1>

    <form action="/admin/categories/create" method="POST" class="card p-4 flex gap-3 mb-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="name" placeholder="Category name" required class="flex-1 bg-navy2 border border-border2 rounded-md px-3 py-2 text-sm">
      <select name="parent" class="bg-navy2 border border-border2 rounded-md px-3 py-2 text-sm">
        <option value="">Top-level category</option>
        <% categories.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %>
      </select>
      <input name="filters" placeholder="Filters (comma-separated)" class="bg-navy2 border border-border2 rounded-md px-3 py-2 text-sm w-48">
      <button class="gradient-btn px-5 py-2 rounded-md text-sm font-medium">Add</button>
    </form>

    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy2"><tr class="text-left text-textSecondary"><th class="p-3">Name</th><th class="p-3">Parent</th><th class="p-3">Status</th><th class="p-3">Actions</th></tr></thead>
        <tbody>
          <% categories.forEach(c => { %>
            <tr class="border-t border-border2">
              <td class="p-3"><%= '—'.repeat(c.level) %> <%= c.name %></td>
              <td class="p-3 text-textSecondary"><%= c.parent?.name || '—' %></td>
              <td class="p-3"><span class="badge-discount"><%= c.isActive ? 'Active' : 'Inactive' %></span></td>
              <td class="p-3 space-x-2">
                <form action="/admin/categories/<%= c._id %>/toggle" method="POST" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-cyan text-xs"><%= c.isActive ? 'Deactivate' : 'Activate' %></button></form>
                <form action="/admin/categories/<%= c._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-error text-xs">Delete</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>