<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6">
    <h1 class="text-2xl font-bold heading mb-6">Platform Analytics</h1>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" id="kpiCards"></div>
    <div class="card p-5">
      <canvas id="salesChart" height="80"></canvas>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
fetch('/api/admin/analytics-data').then(r => r.json()).then(data => {
  document.getElementById('kpiCards').innerHTML = `
    <div class="card p-4"><p class="text-textSecondary text-xs">GMV</p><p class="text-xl font-bold">₹${data.gmv}</p></div>
    <div class="card p-4"><p class="text-textSecondary text-xs">Avg Order Value</p><p class="text-xl font-bold">₹${data.avgOrderValue}</p></div>
    <div class="card p-4"><p class="text-textSecondary text-xs">Return Rate</p><p class="text-xl font-bold text-warning">${data.returnRate}%</p></div>
    <div class="card p-4"><p class="text-textSecondary text-xs">Cancellation Rate</p><p class="text-xl font-bold text-error">${data.cancellationRate}%</p></div>
  `;
  new Chart(document.getElementById('salesChart'), {
    type: 'line',
    data: { labels: data.labels, datasets: [{ label: 'Daily Sales (₹)', data: data.values, borderColor: '#7C3AED', backgroundColor: 'rgba(124,58,237,0.15)', fill: true, tension: 0.3 }] },
    options: { plugins: { legend: { labels: { color: '#F8FAFC' } } }, scales: { x: { ticks: { color: '#94A3B8' } }, y: { ticks: { color: '#94A3B8' } } } },
  });
});
</script>
<%- include('../partials/footer') %>