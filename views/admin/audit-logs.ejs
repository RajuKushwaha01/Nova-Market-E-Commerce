<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6">
    <h1 class="text-2xl font-bold heading mb-4">Audit Logs</h1>
    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy2"><tr class="text-left text-textSecondary"><th class="p-3">User</th><th class="p-3">Action</th><th class="p-3">Entity</th><th class="p-3">IP</th><th class="p-3">Date</th></tr></thead>
        <tbody>
          <% logs.forEach(l => { %>
            <tr class="border-t border-border2">
              <td class="p-3"><%= l.userName %></td>
              <td class="p-3"><%= l.action %></td>
              <td class="p-3 text-textSecondary"><%= l.entity %></td>
              <td class="p-3 text-textSecondary"><%= l.ip %></td>
              <td class="p-3 text-textSecondary"><%= new Date(l.createdAt).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>