<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6">
    <h1 class="text-2xl font-bold heading mb-4">Products</h1>
    <div class="flex gap-3 mb-4 text-sm">
      <% ['','pending','approved','rejected','disabled'].forEach(s => { %>
        <a href="/admin/products?status=<%= s %>" class="px-3 py-1.5 rounded-md <%= query.status === s ? 'gradient-btn' : 'border border-border2 text-textSecondary' %>"><%= s || 'All' %></a>
      <% }) %>
    </div>

    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy2"><tr class="text-left text-textSecondary"><th class="p-3">Product</th><th class="p-3">Seller</th><th class="p-3">Price/Stock</th><th class="p-3">Status</th><th class="p-3">Actions</th></tr></thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr class="border-t border-border2">
              <td class="p-3"><%= p.name %> <% if (p.isFeatured) { %><span class="text-cyan text-xs">★ Featured</span><% } %></td>
              <td class="p-3 text-textSecondary"><%= p.seller?.name || '—' %></td>
              <td class="p-3">
                <form action="/admin/products/<%= p._id %>/price" method="POST" class="flex gap-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="number" name="price" value="<%= p.price %>" class="w-16 bg-navy2 border border-border2 rounded-md px-1 py-1 text-xs">
                  <input type="number" name="stock" value="<%= p.stock %>" class="w-14 bg-navy2 border border-border2 rounded-md px-1 py-1 text-xs">
                  <button class="text-cyan text-xs">Save</button>
                </form>
              </td>
              <td class="p-3"><span class="badge-discount"><%= p.status %></span></td>
              <td class="p-3 space-x-2 whitespace-nowrap">
                <% if (p.status === 'pending') { %>
                  <form action="/admin/products/<%= p._id %>/status" method="POST" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="approved"><button class="text-success text-xs">Approve</button></form>
                  <form action="/admin/products/<%= p._id %>/status" method="POST" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected"><button class="text-error text-xs">Reject</button></form>
                <% } %>
                <form action="/admin/products/<%= p._id %>/featured" method="POST" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-cyan text-xs"><%= p.isFeatured ? 'Unfeature' : 'Feature' %></button></form>
                <form action="/admin/products/<%= p._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-error text-xs">Delete</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>