<%- include('partials/header') %>
<section class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold heading">My Addresses</h1>
    <a href="/addresses/new" class="gradient-btn px-5 py-2 rounded-md font-semibold text-sm">+ Add Address</a>
  </div>

  <% if (addresses.length === 0) { %>
    <div class="card p-10 text-center text-textSecondary">No saved addresses yet.</div>
  <% } %>

  <div class="grid md:grid-cols-2 gap-4">
    <% addresses.forEach(a => { %>
      <div class="card p-4">
        <div class="flex justify-between items-start mb-2">
          <span class="badge-discount"><%= a.addressType %></span>
          <% if (a.isDefault) { %><span class="text-cyan text-xs font-semibold">DEFAULT</span><% } %>
        </div>
        <p class="font-medium"><%= a.fullName %> — <%= a.mobile %></p>
        <p class="text-textSecondary text-sm">
          <%= a.houseNumber %>, <%= a.street %>, <%= a.area %>, <%= a.city %>, <%= a.state %> - <%= a.pincode %>
        </p>
        <div class="flex gap-4 mt-3 text-sm">
          <a href="/addresses/<%= a._id %>/edit" class="text-cyan">Edit</a>
          <form action="/addresses/<%= a._id %>/delete" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-error">Delete</button>
          </form>
          <% if (!a.isDefault) { %>
            <form action="/addresses/<%= a._id %>/default" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="text-textSecondary">Set Default</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>