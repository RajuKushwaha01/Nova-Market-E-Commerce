<%- include('partials/header') %>

<section class="max-w-7xl mx-auto px-4 py-8 grid md:grid-cols-2 gap-10">
  <div>
    <div id="mainImage" class="card h-96 flex items-center justify-center overflow-hidden mb-3">
      <% if (product.images && product.images[0]) { %>
        <img src="<%= product.images[0] %>" id="mainImageTag" class="h-full w-full object-cover" alt="<%= product.name %>">
      <% } else { %> <span class="text-textSecondary">No Image</span> <% } %>
    </div>
    <div class="flex gap-2 overflow-x-auto">
      <% (product.images || []).forEach(img => { %>
        <img src="<%= img %>" onclick="document.getElementById('mainImageTag').src='<%= img %>'"
          class="w-16 h-16 object-cover rounded-md border border-border2 cursor-pointer hover:border-violet">
      <% }) %>
    </div>
  </div>

  <div>
    <p class="text-textSecondary text-sm"><%= product.brand %></p>
    <h1 class="text-2xl font-bold heading mb-2"><%= product.name %></h1>
    <p class="text-sm mb-3">
      <span class="bg-success text-navy px-2 py-0.5 rounded font-semibold text-xs">★ <%= product.rating.toFixed(1) %></span>
      <span class="text-textSecondary ml-2"><%= product.reviewCount %> ratings</span>
    </p>

    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl font-bold">₹<%= product.price.toLocaleString('en-IN') %></span>
      <% if (product.mrp > product.price) { %>
        <span class="price-original text-lg">₹<%= product.mrp.toLocaleString('en-IN') %></span>
        <span class="badge-discount"><%= product.discountPercent %>% off</span>
      <% } %>
    </div>
    <p class="text-textSecondary text-xs mb-4">Inclusive of all taxes</p>

    <% if (product.variants && product.variants.length > 0) { %>
      <div class="mb-4" id="variantSelector" data-product-id="<%= product._id %>">
        <p class="text-sm font-medium mb-2">Select Variant</p>
        <div class="flex flex-wrap gap-2">
          <% product.variants.forEach(v => { %>
            <button type="button" class="variant-btn border border-border2 rounded-md px-3 py-1.5 text-sm hover:border-violet"
              data-variant-id="<%= v._id %>">
              <%= Array.from(v.attributes.values()).join(' / ') %>
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="card p-4 mb-4">
      <p class="text-sm font-medium mb-2">Delivery Options</p>
      <div class="flex gap-2">
        <input type="text" id="pincodeInput" maxlength="6" placeholder="Enter Pincode"
          class="bg-navy2 border border-border2 rounded-md px-3 py-2 text-sm w-40">
        <button id="checkPincodeBtn" class="gradient-btn px-4 py-2 rounded-md text-sm font-medium">Check</button>
      </div>
      <div id="pincodeResult" class="text-sm mt-2 text-textSecondary"></div>
    </div>

    <p class="text-sm text-textSecondary mb-4">
      Stock: <%= product.availableStock > 0 ? product.availableStock + ' available' : 'Out of stock' %>
      &middot; Sold by <%= product.seller?.sellerProfile?.businessName || product.seller?.name || 'NOVA Market' %>
    </p>

    <% if (user) { %>
      <div class="flex gap-3 mb-3">
        <form action="/cart/add" method="POST" class="flex-1 flex gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <input type="hidden" name="variantId" id="selectedVariantId" value="">
          <input type="number" name="quantity" value="1" min="1" class="w-20 bg-navy2 border border-border2 rounded-md px-3 py-2">
          <button class="gradient-btn flex-1 py-2 rounded-md font-semibold" <%= product.availableStock === 0 ? 'disabled' : '' %>>Add to Cart</button>
        </form>
        <button id="wishlistToggleBtn" data-id="<%= product._id %>" data-active="<%= inWishlist %>"
          class="border border-border2 px-5 rounded-md hover:border-error"><%= inWishlist ? '❤' : '♡' %></button>
      </div>
      <form action="/compare/add" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product._id %>">
        <button class="text-cyan text-sm">+ Add to Compare</button>
      </form>
    <% } else { %>
      <a href="/login" class="gradient-btn block text-center py-2 rounded-md font-semibold mb-3">Login to Buy</a>
    <% } %>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 pb-10 grid md:grid-cols-2 gap-6">
  <div class="card p-6">
    <h3 class="font-semibold mb-3">Highlights</h3>
    <ul class="list-disc list-inside text-sm text-textSecondary space-y-1">
      <% (product.highlights || []).forEach(h => { %><li><%= h %></li><% }) %>
    </ul>
    <h3 class="font-semibold mt-5 mb-2">Description</h3>
    <p class="text-sm text-textSecondary"><%= product.description %></p>
  </div>

  <div class="card p-6">
    <h3 class="font-semibold mb-3">Specifications</h3>
    <table class="w-full text-sm">
      <% if (product.specifications) { for (const [key, val] of product.specifications) { %>
        <tr class="border-b border-border2">
          <td class="py-2 text-textSecondary w-1/3"><%= key %></td>
          <td class="py-2"><%= val %></td>
        </tr>
      <% } } %>
    </table>
    <p class="text-sm text-textSecondary mt-4">Warranty: <%= product.warranty %></p>
    <p class="text-sm text-textSecondary">Return Policy: <%= product.returnPolicy %></p>
  </div>
</section>

<% if (frequentlyBought.length > 0) { %>
<section class="max-w-7xl mx-auto px-4 pb-10">
  <h2 class="text-xl font-bold heading mb-4">Frequently Bought Together</h2>
  <div class="card p-5 flex flex-wrap items-center gap-4">
    <% frequentlyBought.forEach((p, i) => { %>
      <span class="text-sm"><%= p.name %> (₹<%= p.price %>)</span>
      <% if (i < frequentlyBought.length - 1) { %><span class="text-textSecondary">+</span><% } %>
    <% }) %>
    <span class="text-textSecondary ml-auto text-sm">
      Combined: ₹<%= frequentlyBought.reduce((s,p) => s + p.price, product.price) %>
    </span>
  </div>
</section>
<% } %>

<section class="max-w-7xl mx-auto px-4 pb-10" id="questions">
  <h2 class="text-xl font-bold heading mb-4">Questions & Answers</h2>

  <% if (user) { %>
    <form action="/questions/ask" method="POST" class="card p-4 flex gap-3 mb-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product._id %>">
      <input name="text" placeholder="Ask a question about this product..." required
        class="flex-1 bg-navy2 border border-border2 rounded-md px-3 py-2 text-sm">
      <button class="gradient-btn px-5 rounded-md text-sm font-medium">Ask</button>
    </form>
  <% } %>

  <div class="space-y-4">
    <% questions.forEach(q => { %>
      <div class="card p-4">
        <p class="font-medium text-sm">Q: <%= q.text %></p>
        <p class="text-xs text-textSecondary mb-2">— <%= q.askedBy?.name || 'User' %></p>
        <% q.answers.forEach(a => { %>
          <p class="text-sm text-cyan ml-4">A: <%= a.text %> <span class="text-textSecondary text-xs">(<%= a.answererRole %>)</span></p>
        <% }) %>
        <div class="flex gap-4 mt-2 text-xs">
          <form action="/questions/<%= q._id %>/helpful" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-textSecondary">👍 Helpful (<%= q.helpfulCount %>)</button>
          </form>
          <form action="/questions/<%= q._id %>/report" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-error">Report</button>
          </form>
        </div>
      </div>
    <% }) %>
    <% if (questions.length === 0) { %>
      <p class="text-textSecondary text-sm">No questions yet. Be the first to ask!</p>
    <% } %>
  </div>
</section>

<%- include('partials/review-section') %>

<section class="max-w-7xl mx-auto px-4 pb-16">
  <h2 class="text-xl font-bold heading mb-4">Related Products</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
    <% related.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>

<script src="/js/product-page.js"></script>
<script src="/js/wishlist.js"></script>
<%- include('partials/footer') %>