<%- include('partials/header') %>
<section class="max-w-md mx-auto px-4 py-16">
  <div class="card p-8">
    <h1 class="text-xl font-bold heading mb-6 gradient-text">Reset Password</h1>
    <% if (error) { %>
      <p class="text-error text-sm mb-4"><%= error %></p>
      <a href="/forgot-password" class="text-cyan text-sm">Request a new link</a>
    <% } else { %>
      <form action="/reset-password/<%= token %>" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="password" name="password" placeholder="New Password" required minlength="8"
          class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
        <input type="password" name="confirmPassword" placeholder="Confirm New Password" required minlength="8"
          class="w-full bg-navy2 border border-border2 rounded-md px-3 py-2">
        <button class="gradient-btn w-full py-2 rounded-md font-semibold">Reset Password</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>