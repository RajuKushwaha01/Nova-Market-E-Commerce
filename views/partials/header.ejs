<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof metaTitle !== 'undefined' ? metaTitle : 'NOVA MARKET - Shop the Future of Retail' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Premium products, unbeatable prices, delivered fast on NOVA MARKET.' %>">
  <meta property="og:title" content="<%= typeof metaTitle !== 'undefined' ? metaTitle : 'NOVA MARKET' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Shop premium products on NOVA MARKET.' %>">
  <meta property="og:type" content="website">
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : (process.env.CLIENT_URL || '') %>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: '#070B17', navy2: '#0D1324', violet: '#7C3AED',
            cyan: '#06B6D4', softviolet: '#A78BFA', card: '#111827', border2: '#1E293B'
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>window.csrfToken = "<%= csrfToken %>";</script>
</head>
<body class="bg-navy text-white min-h-screen">

<header class="sticky top-0 z-50 bg-navy2 border-b border-border2">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3 gap-4">
    <a href="/" class="text-xl font-bold heading gradient-text">NOVA MARKET</a>

    <form action="/search" method="GET" class="hidden md:flex flex-1 max-w-xl">
      <input type="text" name="q" placeholder="Search products, brands..."
        class="w-full px-4 py-2 rounded-l-md bg-card border border-border2 text-sm focus:outline-none focus:border-violet">
      <button class="gradient-btn px-4 rounded-r-md text-sm">Search</button>
    </form>

    <div class="flex items-center gap-4 text-sm">
      <% if (user) { %>
        <a href="/orders" class="hover:text-cyan">Orders</a>
        <a href="/notifications" class="hover:text-cyan">🔔</a>
        <a href="/rewards" class="hover:text-cyan">Coins</a>
        <a href="/support/tickets" class="hover:text-cyan">Support</a>
        <span class="text-textSecondary">Hi, <%= user.name %></span>
        <a href="/logout" class="hover:text-cyan">Logout</a>
      <% } else { %>
        <a href="/login" class="hover:text-cyan">Login</a>
        <a href="/register" class="hover:text-cyan">Register</a>
      <% } %>
      <a href="/cart" class="hover:text-cyan">Cart</a>
    </div>
  </div>
</header>