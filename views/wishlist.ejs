<%- include('partials/header') %>
<section class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold heading mb-6">My Wishlist</h1>
  <% if (items.length === 0) { %>
    <div class="card p-10 text-center text-textSecondary">Your wishlist is empty.</div>
  <% } %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
    <% items.forEach(item => { %>
      <div class="card p-3">
        <a href="/product/<%= item.product._id %>">
          <div class="bg-navy2 h-32 rounded-md mb-2 overflow-hidden">
            <img src="<%= item.product.images[0] || '' %>" class="h-full w-full object-cover">
          </div>
          <p class="text-sm font-medium truncate"><%= item.product.name %></p>
          <p class="text-sm font-bold">₹<%= item.product.price %></p>
          <% if (item.product.price < item.priceAtAdd) { %>
            <p class="text-success text-xs">Price dropped since you added it!</p>
          <% } %>
        </a>
        <div class="flex gap-3 mt-2 text-xs">
          <form action="/wishlist/<%= item.product._id %>/move-to-cart" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-cyan">Move to Cart</button>
          </form>
          <form action="/wishlist/<%= item.product._id %>/remove" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-error">Remove</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>