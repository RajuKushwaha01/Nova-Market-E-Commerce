<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6">
    <h1 class="text-2xl font-bold heading mb-6">Inventory</h1>

    <form action="/seller/inventory/bulk-update" method="POST" class="card overflow-x-auto">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <table class="w-full text-sm">
        <thead class="bg-navy2">
          <tr class="text-left text-textSecondary"><th class="p-3">Product</th><th class="p-3">SKU</th><th class="p-3">Stock</th><th class="p-3">Status</th></tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr class="border-t border-border2">
              <td class="p-3 flex items-center gap-2">
                <img src="<%= p.images[0] || '' %>" class="w-10 h-10 rounded-md object-cover bg-navy2">
                <%= p.name %>
              </td>
              <td class="p-3 text-textSecondary"><%= p.sku || '—' %></td>
              <td class="p-3">
                <input type="hidden" name="productIds" value="<%= p._id %>">
                <input type="number" name="stocks" value="<%= p.stock %>" class="w-20 bg-navy2 border border-border2 rounded-md px-2 py-1">
              </td>
              <td class="p-3">
                <% if (p.stock === 0) { %><span class="text-error text-xs">Out of Stock</span>
                <% } else if (p.stock <= 5) { %><span class="text-warning text-xs">Low Stock</span>
                <% } else { %><span class="text-success text-xs">In Stock</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="p-4"><button class="gradient-btn px-6 py-2 rounded-md font-semibold text-sm">Save All Changes</button></div>
    </form>
  </main>
</div>
<%- include('../partials/footer') %>