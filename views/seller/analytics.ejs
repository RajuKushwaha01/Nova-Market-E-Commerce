<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6">
    <h1 class="text-2xl font-bold heading mb-6">Analytics</h1>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="card p-4"><p class="text-textSecondary text-xs">Revenue</p><p class="text-xl font-bold">₹<%= revenue %></p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Total Orders</p><p class="text-xl font-bold"><%= totalOrders %></p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Avg Order Value</p><p class="text-xl font-bold">₹<%= avgOrderValue %></p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Product Views</p><p class="text-xl font-bold"><%= totalViews %></p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Conversion Rate</p><p class="text-xl font-bold"><%= conversionRate %>%</p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Return Rate</p><p class="text-xl font-bold text-warning"><%= returnRate %>%</p></div>
      <div class="card p-4"><p class="text-textSecondary text-xs">Cancellation Rate</p><p class="text-xl font-bold text-error"><%= cancellationRate %>%</p></div>
    </div>

    <h2 class="text-lg font-bold heading mb-3">Top Products</h2>
    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy2"><tr class="text-left text-textSecondary"><th class="p-3">Product</th><th class="p-3">Units Sold</th><th class="p-3">Views</th></tr></thead>
        <tbody>
          <% topProducts.forEach(p => { %>
            <tr class="border-t border-border2"><td class="p-3"><%= p.name %></td><td class="p-3"><%= p.soldCount %></td><td class="p-3"><%= p.viewCount %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>