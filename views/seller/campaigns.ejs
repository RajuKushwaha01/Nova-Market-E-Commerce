<%- include('../partials/header') %>
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 p-6 max-w-4xl">
    <h1 class="text-2xl font-bold heading mb-6">Advertising & Campaigns</h1>

    <form action="/seller/campaigns/create" method="POST" class="card p-5 mb-8 space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid md:grid-cols-2 gap-3">
        <select name="productId" required class="bg-navy2 border border-border2 rounded-md px-3 py-2">
          <option value="">Select Product</option>
          <% products.forEach(p => { %><option value="<%= p._id %>"><%= p.name %></option><% }) %>
        </select>
        <select name="type" class="bg-navy2 border border-border2 rounded-md px-3 py-2">
          <option value="Sponsored">Sponsored Listing</option>
          <option value="SearchAd">Search Ad</option>
          <option value="CategoryAd">Category Ad</option>
        </select>
      </div>
      <div class="grid md:grid-cols-3 gap-3">
        <input type="number" name="budget" placeholder="Budget (₹)" required class="bg-navy2 border border-border2 rounded-md px-3 py-2">
        <input type="date" name="startDate" required class="bg-navy2 border border-border2 rounded-md px-3 py-2">
        <input type="date" name="endDate" required class="bg-navy2 border border-border2 rounded-md px-3 py-2">
      </div>
      <button class="gradient-btn px-6 py-2 rounded-md font-semibold text-sm">Submit Campaign for Approval</button>
    </form>

    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-navy2">
          <tr class="text-left text-textSecondary">
            <th class="p-3">Product</th><th class="p-3">Type</th><th class="p-3">Budget</th><th class="p-3">Spend</th>
            <th class="p-3">Clicks</th><th class="p-3">Impressions</th><th class="p-3">Status</th><th class="p-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% campaigns.forEach(c => { %>
            <tr class="border-t border-border2">
              <td class="p-3"><%= c.product?.name || '—' %></td>
              <td class="p-3"><%= c.type %></td>
              <td class="p-3">₹<%= c.budget %></td>
              <td class="p-3">₹<%= c.spend %></td>
              <td class="p-3"><%= c.clicks %></td>
              <td class="p-3"><%= c.impressions %></td>
              <td class="p-3"><span class="badge-discount"><%= c.status %></span></td>
              <td class="p-3">
                <% if (['active','paused'].includes(c.status)) { %>
                  <form action="/seller/campaigns/<%= c._id %>/pause" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="text-cyan text-xs"><%= c.status === 'paused' ? 'Resume' : 'Pause' %></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (campaigns.length === 0) { %><tr><td colspan="8" class="p-6 text-center text-textSecondary">No campaigns yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>