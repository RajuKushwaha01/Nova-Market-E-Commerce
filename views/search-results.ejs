<%- include('partials/header') %>
<%- include('partials/category-nav') %>

<section class="max-w-7xl mx-auto px-4 py-8">
  <form action="/search" method="GET" class="mb-8 max-w-xl">
    <div class="flex">
      <input id="searchInput" type="text" name="q" value="<%= q %>" autocomplete="off" placeholder="Search products, brands and more..."
        class="w-full px-4 py-3 rounded-l-md bg-navy2 border border-border2 focus:outline-none focus:border-violet">
      <button class="gradient-btn px-6 rounded-r-md font-medium">Search</button>
    </div>
    <div id="suggestionsBox" class="relative"></div>
  </form>

  <% if (!q) { %>
    <div class="grid md:grid-cols-2 gap-8">
      <% if (recentSearches.length > 0) { %>
        <div class="card p-5">
          <div class="flex justify-between items-center mb-3">
            <h3 class="font-semibold">Recent Searches</h3>
            <form action="/search-history/clear" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="text-error text-xs">Clear All</button>
            </form>
          </div>
          <div class="space-y-2">
            <% recentSearches.forEach(s => { %>
              <div class="flex justify-between items-center text-sm">
                <a href="/search?q=<%= s.query %>" class="text-textSecondary hover:text-cyan"><%= s.query %></a>
                <form action="/search-history/<%= s._id %>/delete" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="text-error text-xs">✕</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="card p-5">
        <h3 class="font-semibold mb-3">Trending Searches</h3>
        <div class="flex flex-wrap gap-2">
          <% trendingSearches.forEach(t => { %>
            <a href="/search?q=<%= t._id %>" class="text-xs bg-navy2 border border-border2 px-3 py-1.5 rounded-full hover:border-violet"><%= t._id %></a>
          <% }) %>
        </div>
      </div>
    </div>
  <% } else { %>
    <p class="text-textSecondary text-sm mb-4"><%= results.length %> results for "<%= q %>"</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      <% results.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
      <% if (results.length === 0) { %>
        <div class="col-span-4 card p-10 text-center text-textSecondary">No results found for "<%= q %>".</div>
      <% } %>
    </div>
  <% } %>
</section>

<script src="/js/search.js"></script>
<%- include('partials/footer') %>